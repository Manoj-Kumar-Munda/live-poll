PORT=4000
NODE_ENV=development
CLIENT_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000
BETTER_AUTH_URL=http://localhost:4000
BETTER_AUTH_SECRET=your-secret-min-32-characters-long
RESEND_API_KEY=your-resend-api-key
RESEND_FROM_EMAIL=onboarding@resend.dev
MONGODB_URI=mongodb://localhost:27017/livepoll-db
# Atlas (standard URI from Atlas UI — include ssl + authSource):
# MONGODB_URI=mongodb://USER:PASS@host1:27017,host2:27017,host3:27017/livepoll-db?ssl=true&authSource=admin
# Atlas (SRV — needs working DNS SRV on your network):
# MONGODB_URI=mongodb+srv://USER:PASS@cluster0.xxxxx.mongodb.net/livepoll-db
